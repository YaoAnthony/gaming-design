{
  "name": "game-master",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "test": "vitest run",
    "gen-art": "node scripts/gen-art.mjs",
    "level": "node scripts/level.mjs",
    "lint": "eslint .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:pack:win": "npm run build && electron-builder --win dir --x64",
    "desktop:pack:mac": "npm run build && electron-builder --mac dir --universal",
    "desktop:pack:linux": "npm run build && electron-builder --linux dir --x64",
    "steam:upload": "node scripts/steam-upload.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^6.6.5",
    "i18next": "^26.4.2",
    "motion": "^13.4.1",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.1.2",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.cjs",
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.gamemaster.desktop",
    "productName": "Game Master",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/steamworks.js/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "x64ArchFiles": "**/steamworks.js/dist/osx/*.node"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    }
  },
  "description": "Game Master"
}
